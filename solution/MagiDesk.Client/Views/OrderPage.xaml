<UserControl
    x:Class="MagiDesk.Client.Views.OrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MagiDesk.Client.ViewModels"
    xmlns:dto="using:MagiDesk.Client.Services.Dtos"
    xmlns:shared="using:MagiDesk.Shared.DTOs.Tables"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Menu Grid -->
        <Grid Grid.Column="0" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="Menu" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12"/>
            
            <GridView Grid.Row="1" ItemsSource="{Binding MenuItems}">
                <GridView.ItemTemplate>
                    <DataTemplate> <!-- Removed x:DataType -->
                        <Button Width="180" Height="100" Margin="5" Padding="0"
                                Command="{Binding DataContext.AddToTicketCommand, ElementName=RootGrid}"
                                CommandParameter="{Binding}"> <!-- Changed to Binding -->
                             <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                   CornerRadius="8" BorderBrush="Gray" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Sku}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxWidth="160" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding SellingPrice}" Foreground="Gray"/>
                                </StackPanel>
                             </Grid>
                        </Button>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>

        <!-- Right: Ticket -->
        <Grid Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" Padding="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Spacing="8">
                <TextBlock Text="Current Order" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <TextBlock FontWeight="Bold">
                    <Run Text="Table: "/>
                    <Run Text="{Binding TableLabel}"/>
                </TextBlock>
            </StackPanel>

            <ListView Grid.Row="1" ItemsSource="{Binding TicketItems}" Margin="0,10">
                 <ListView.ItemContainerStyle>
                     <Style TargetType="ListViewItem">
                         <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                     </Style>
                 </ListView.ItemContainerStyle>
                 <ListView.ItemTemplate>
                     <DataTemplate> <!-- Removed x:DataType -->
                         <Grid>
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="Auto"/>
                                 <ColumnDefinition Width="Auto"/>
                             </Grid.ColumnDefinitions>
                             <TextBlock Text="{Binding ItemId}" VerticalAlignment="Center"/>
                             
                             <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                 <AppBarButton Icon="Remove" Width="30" Height="30"
                                               Command="{Binding DataContext.RemoveFromTicketCommand, ElementName=RootGrid}"
                                               CommandParameter="{Binding}"/>
                                 <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" Width="20" TextAlignment="Center"/>
                             </StackPanel>
                         </Grid>
                     </DataTemplate>
                 </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" Spacing="10">
                <Button Content="Send Order" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding SubmitOrderCommand}"/>
                <!-- Debug Button -->
                <Button Content="🔍 View Submitted Orders (Debug)" HorizontalAlignment="Stretch" Background="Gray"
                        Command="{Binding ViewOrdersCommand}"/>
                <!-- Settle Button -->
                <Button Content="Settle &amp; Close Session" HorizontalAlignment="Stretch" Background="DarkRed" Foreground="White"
                        Command="{Binding StopSessionCommand}"/>
                <Button Content="Cancel" HorizontalAlignment="Stretch"
                        Command="{Binding CancelCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
