<UserControl
    x:Class="MagiDesk.Client.Views.ShiftControllerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MagiDesk.Client.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Active Shift Area -->
            <RowDefinition Height="*"/>    <!-- History -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <CommandBar DefaultLabelPosition="Right" Background="Transparent" Grid.Row="0">
            <CommandBar.Content>
                <TextBlock Text="Shift Controller" Style="{StaticResource TitleTextBlockStyle}" Margin="12,14,0,0"/>
            </CommandBar.Content>
            <AppBarButton Icon="Refresh" Label="Refresh" Command="{Binding LoadCommand}"/>
        </CommandBar>

        <!-- Active Shift Section -->
        <Grid Grid.Row="1" Margin="20" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" Padding="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Status Info -->
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding ShiftStatusText}" Style="{StaticResource SubtitleTextBlockStyle}"/>
                
                <StackPanel Orientation="Horizontal" Spacing="20" Visibility="{Binding IsShiftOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Starting Cash" Foreground="Gray"/>
                        <TextBlock Text="{Binding StartingCash}" FontSize="18"/>
                    </StackPanel>
                     <StackPanel>
                        <TextBlock Text="Opened By" Foreground="Gray"/>
                        <TextBlock Text="{Binding CurrentShift.OpenedByName}" FontSize="18"/>
                    </StackPanel>
                     <StackPanel>
                        <TextBlock Text="Opened At" Foreground="Gray"/>
                        <TextBlock Text="{Binding CurrentShift.OpenedAt}" FontSize="18"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                 <Button Content="Open New Shift" Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding OpenShiftCommand}"
                        Visibility="{Binding IsShiftOpen, Converter={StaticResource BoolToVisibilityInverseConverter}}"/> <!-- Need Inverse Converter or use multiple bindings -->
                        
                 <Button Content="Close Shift"
                        Command="{Binding CloseShiftCommand}"
                        Visibility="{Binding IsShiftOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>

        <!-- History Section -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="Recent Shifts" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,10"/>
            
            <ListView ItemsSource="{Binding ShiftHistory}" SelectionMode="None" Grid.Row="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <FontIcon Glyph="&#xE81C;" FontSize="20" VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{Binding OpenedAt}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding OpenedByName}" Foreground="Gray" Style="{StaticResource CaptionTextBlockStyle}"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Margin="10,0" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusColorConverter}}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="10,0">
                                <Run Text="#"/>
                                <Run Text="{Binding ShiftNumber}"/>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        
        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3" Background="#88000000" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <ProgressRing IsActive="True" Width="50" Height="50"/>
        </Grid>
    </Grid>
</UserControl>
