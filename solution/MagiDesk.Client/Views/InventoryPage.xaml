<UserControl
    x:Class="MagiDesk.Client.Views.InventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MagiDesk.Client.ViewModels"
    xmlns:dto="using:MagiDesk.Shared.DTOs.Inventory"
    mc:Ignorable="d"
    x:Name="Root">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,20">
            <TextBlock Text="Inventory Management" Style="{StaticResource TitleTextBlockStyle}"/>
            <Button Content="Refresh" Command="{x:Bind ViewModel.LoadItemsCommand}" />
            <Button Content="Add Item" Command="{x:Bind ViewModel.AddItemCommand}" Style="{StaticResource AccentButtonStyle}"/>
        </StackPanel>

        <ListView x:Name="InventoryList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="dto:InventoryItemDto">
                    <Grid Padding="10" Background="{ThemeResource LayerFillColorDefaultBrush}" Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind Unit}" Foreground="Gray"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Column="1" Text="{x:Bind Quantity}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                            <Button Content="+" Command="{Binding DataContext.AdjustStockCommand, ElementName=InventoryList}" CommandParameter="{x:Bind}" />
                            <Button Content="-" Command="{Binding DataContext.ReduceStockCommand, ElementName=InventoryList}" CommandParameter="{x:Bind}" />
                            <Button Background="Transparent" BorderThickness="0" Margin="10,0,0,0" Command="{Binding DataContext.DeleteItemCommand, ElementName=InventoryList}" CommandParameter="{x:Bind}">
                                <SymbolIcon Symbol="Delete" Foreground="Red"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="50" Height="50"/>
    </Grid>
</UserControl>
