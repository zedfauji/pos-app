<Page
    x:Class="MagiDesk.Client.Views.PaymentWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MagiDesk.Client.ViewModels"
    xmlns:dto="using:MagiDesk.Shared.DTOs.Tables"
    xmlns:pay="using:MagiDesk.Shared.DTOs.Payments"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Payment Controls -->
        <Grid Grid.Column="0" Padding="0,0,20,0">
            <ScrollViewer>
                <StackPanel Spacing="20">
                    <!-- Header -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Process Payment" Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBlock>
                            <Run Text="Table:"/>
                            <Run Text="{x:Bind ViewModel.TableLabel, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                        <Button Content="← Back to Hub" Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}" 
                                Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>

                    <!-- Split Payment Toggle -->
                    <StackPanel Spacing="12" 
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                Padding="16"
                                CornerRadius="8"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                        <ToggleSwitch Header="Split Payment" 
                                      IsOn="{Binding IsSplitPayment, Mode=TwoWay}"
                                      OnContent="Split Mode Active"
                                      OffContent="Full Payment"/>
                        
                        <!-- Split Mode Selection (only visible when split is enabled) -->
                        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsSplitPayment, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Split Mode" FontWeight="SemiBold"/>
                            <StackPanel Spacing="8">
                                <RadioButton Content="By Amount" 
                                             IsChecked="{Binding SplitMode, Mode=TwoWay, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=ByAmount}"
                                             GroupName="SplitMode"/>
                                <RadioButton Content="By Percentage" 
                                             IsChecked="{Binding SplitMode, Mode=TwoWay, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=ByPercentage}"
                                             GroupName="SplitMode"/>
                                <RadioButton Content="By Item" 
                                             IsChecked="{Binding SplitMode, Mode=TwoWay, Converter={StaticResource StringEqualsToBoolConverter}, ConverterParameter=ByItem}"
                                             GroupName="SplitMode"/>
                            </StackPanel>

                            <!-- By Amount Input -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SplitMode, Mode=OneWay, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=ByAmount}">
                                <TextBlock Text="Amount to Pay"/>
                                <NumberBox Value="{Binding SplitAmount, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Inline"
                                           Minimum="0"
                                           Maximum="{x:Bind ViewModel.TotalDue, Mode=OneWay}"
                                           LargeChange="10"
                                           SmallChange="1"/>
                            </StackPanel>

                            <!-- By Percentage Input -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SplitMode, Mode=OneWay, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=ByPercentage}">
                                <TextBlock Text="Percentage to Pay"/>
                                <NumberBox Value="{Binding SplitPercentage, Mode=TwoWay}"
                                           SpinButtonPlacementMode="Inline"
                                           Minimum="1"
                                           Maximum="100"
                                           LargeChange="10"
                                           SmallChange="5"/>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{ThemeResource SystemAccentColor}">
                                    <Run Text="{x:Bind ViewModel.SplitPercentage, Mode=OneWay}"/><Run Text="%"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- By Item Selection -->
                            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.SplitMode, Mode=OneWay, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=ByItem}">
                                <TextBlock Text="Select Items"/>
                                <ListView ItemsSource="{x:Bind ViewModel.BillItems, Mode=OneWay}"
                                          SelectionChanged="ListView_SelectionChanged"
                                          SelectionMode="Multiple"
                                          MaxHeight="150">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="dto:ItemLine">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding name}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding price, Converter={StaticResource CurrencyConverter}}" 
                                                           Foreground="Gray"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>

                            <!-- Calculate Button -->
                            <Button Content="Calculate Split Amount" 
                                    Command="{x:Bind ViewModel.CalculateSplitCommand, Mode=OneWay}"
                                    HorizontalAlignment="Stretch"/>

                            <!-- Calculated Amount Display -->
                            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.CalculatedSplitAmount, Mode=OneWay, Converter={StaticResource ZeroToCollapsedConverter}}">
                                <TextBlock Text="Amount to Pay:"  FontSize="14" Foreground="Gray"/>
                                <TextBlock Text="{x:Bind ViewModel.CalculatedSplitAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource SystemAccentColor}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Payment Method Selection -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Payment Method" FontWeight="SemiBold" FontSize="16"/>
                        <StackPanel Spacing="8">
                            <RadioButton Content="Cash" 
                                         IsChecked="{Binding SelectedPaymentMethod, Mode=TwoWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Cash}"
                                         GroupName="PaymentMethod"/>
                            <RadioButton Content="Card" 
                                         IsChecked="{Binding SelectedPaymentMethod, Mode=TwoWay, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Card}"
                                         GroupName="PaymentMethod"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Cash Payment Section -->
                    <StackPanel Spacing="12" x:Name="CashPanel">
                        <TextBlock Text="Cash Payment" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="Amount Tendered"/>
                        <NumberBox Value="{Binding AmountTendered, Mode=TwoWay}" 
                                   SpinButtonPlacementMode="Inline"
                                   Minimum="0"
                                   LargeChange="10"
                                   SmallChange="1"/>
                        <TextBlock>
                            <Run Text="Change Due:"/>
                            <Run Text="{x:Bind ViewModel.ChangeDue, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" 
                                 FontWeight="Bold" 
                                 Foreground="{ThemeResource SystemAccentColor}" 
                                 FontSize="20"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- Card Payment Section -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.SelectedPaymentMethod, Mode=OneWay, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Card}">
                        <TextBlock Text="Card Payment" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock Text="Tip Amount (Optional)"/>
                        <NumberBox Value="{Binding TipAmount, Mode=TwoWay}" 
                                   SpinButtonPlacementMode="Inline"
                                   Minimum="0"
                                   LargeChange="5"
                                   SmallChange="1"/>
                    </StackPanel>

                    <!-- Discount -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Discount (Optional)" FontWeight="SemiBold" FontSize="16"/>
                        <NumberBox Value="{Binding DiscountAmount, Mode=TwoWay}" 
                                   SpinButtonPlacementMode="Inline"
                                   Minimum="0"
                                   Maximum="{x:Bind ViewModel.TotalDue, Mode=OneWay}"/>
                    </StackPanel>

                    <!-- Customer Email -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Customer Email (Optional)" FontWeight="SemiBold" FontSize="16"/>
                        <TextBox Text="{Binding CustomerEmail, Mode=TwoWay}" 
                                 PlaceholderText="customer@example.com"/>
                    </StackPanel>

                    <!-- Process Button -->
                    <StackPanel Spacing="12">
                        <Button Command="{x:Bind ViewModel.ProcessPaymentCommand, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="56"
                                FontSize="18"
                                IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsProcessing, Mode=OneWay}" Width="20" Height="20" Visibility="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Text="Process Payment" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>

                        <!-- Status Messages -->
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                                   Foreground="Green" 
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource EmptyStringToCollapsedConverter}}"/>
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" 
                                   Foreground="Red" 
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource EmptyStringToCollapsedConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Right Column: Bill View -->
        <Grid Grid.Column="1" 
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              CornerRadius="8"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="1"
              Padding="24">
            <ScrollViewer>
                <StackPanel Spacing="16">
                    <!-- Bill Header -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Bill Summary" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="Bold"/>
                        <TextBlock Text="{x:Bind ViewModel.TableLabel, Mode=OneWay}" FontSize="20" Foreground="Gray"/>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Items List -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Items" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.BillItems, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dto:ItemLine">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding name}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Margin="8,0">
                                            <Run Text="×"/>
                                            <Run Text="{Binding quantity}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding price, Converter={StaticResource CurrencyConverter}}" 
                                                   FontWeight="SemiBold"
                                                   MinWidth="80"
                                                   TextAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Totals -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Subtotal"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Subtotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" MinWidth="80" TextAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tax"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Tax, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" MinWidth="80" TextAlignment="Right"/>
                        </Grid>
                        <Grid Visibility="{x:Bind ViewModel.DiscountAmount, Mode=OneWay, Converter={StaticResource ZeroToCollapsedConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Discount" Foreground="Green"/>
                            <TextBlock Grid.Column="1" Foreground="Green">
                                <Run Text="-"/>
                                <Run Text="{x:Bind ViewModel.DiscountAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <Border Height="2" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Final Total -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="Total Due" 
                                   FontSize="20" 
                                   FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{x:Bind ViewModel.FinalTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" 
                                   FontSize="24" 
                                   FontWeight="Bold"
                                   Foreground="{ThemeResource SystemAccentColor}"
                                   MinWidth="120"
                                   TextAlignment="Right"/>
                    </Grid>

                    <Border Height="2" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Payment History (New Section) -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Payment History" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PaymentHistory, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pay:PaymentDto">
                                    <Grid Margin="0,4" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="8" CornerRadius="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Time -->
                                        <TextBlock Grid.Column="0" Text="{Binding CreatedAt.Year}" 
                                                   VerticalAlignment="Center" Foreground="Gray" Width="50"/>

                                        <!-- Method -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Method" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PaymentMethod}" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <!-- Amount -->
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding AmountPaid, Converter={StaticResource CurrencyConverter}}" 
                                                   VerticalAlignment="Center" 
                                                   FontWeight="Bold"
                                                   Margin="16,0"/>

                                        <!-- Void Button -->
                                        <Button Grid.Column="3" 
                                                Content="Void" 
                                                FontSize="10"
                                                Padding="4,2"
                                                BorderThickness="1"
                                                Background="Transparent"
                                                Foreground="Red"
                                                BorderBrush="Red"
                                                Command="{Binding ElementName=RootGrid, Path=DataContext.VoidPaymentCommand}"
                                                CommandParameter="{Binding}">
                                            <!-- Hide void button if amount <= 0 (already void, or void itself) -->
                                            <!-- Simple visibility binding could go here if AmountPaid exposing property -->
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No payments recorded" 
                                   Foreground="Gray" 
                                   FontStyle="Italic" 
                                   Visibility="{x:Bind ViewModel.PaymentHistory.Count, Mode=OneWay, Converter={StaticResource ZeroToVisibleConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
