<Page
    x:Class="MagiDesk.Client.Views.PaymentHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MagiDesk.Client.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <TextBlock Text="Payment Hub" Style="{StaticResource TitleTextBlockStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Refresh" Command="{Binding LoadSessionsCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5"/>
                    </Button.KeyboardAccelerators>
                </Button>
                <ProgressRing IsActive="{Binding IsLoading}" Width="24" Height="24"/>
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="Red" 
                           VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource EmptyStringToCollapsedConverter}}"/>
            </StackPanel>
        </StackPanel>

        <!-- Active Sessions Grid -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding ActiveSessions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionCardViewModel">
                        <Button Width="300" Height="180" 
                                Margin="10"
                                Padding="0"
                                HorizontalContentAlignment="Stretch" 
                                VerticalContentAlignment="Stretch"
                                Command="{Binding DataContext.NavigateToPaymentCommand, ElementName=RootGrid}"
                                CommandParameter="{x:Bind}">
                            <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  CornerRadius="8" 
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                  BorderThickness="1"
                                  Padding="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Table Label -->
                                <TextBlock Grid.Row="0" 
                                           Text="{x:Bind TableLabel}" 
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           FontWeight="Bold"/>

                                <!-- Server & Time -->
                                <StackPanel Grid.Row="1" Spacing="4" Margin="0,8,0,0">
                                    <TextBlock>
                                        <Run Text="Server: "/>
                                        <Run Text="{x:Bind ServerName}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock>
                                        <Run Text="Open: "/>
                                        <Run Text="{x:Bind DisplayTime}" Foreground="Gray"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Spacer -->
                                <Border Grid.Row="2"/>

                                <!-- Total Amount -->
                                <StackPanel Grid.Row="3" Spacing="4">
                                    <TextBlock Text="Current Total" 
                                               FontSize="12" 
                                               Foreground="Gray"/>
                                    <TextBlock Text="{x:Bind CurrentTotal, Converter={StaticResource CurrencyConverter}}" 
                                               Style="{StaticResource SubtitleTextBlockStyle}"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel Grid.Row="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Visibility="{Binding ActiveSessions.Count, Converter={StaticResource ZeroToVisibleConverter}}"
                    Spacing="10">
            <FontIcon Glyph="&#xE73C;" FontSize="48" Foreground="Gray"/>
            <TextBlock Text="No active sessions" 
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="Gray"/>
            <TextBlock Text="Active table sessions will appear here" 
                       Foreground="Gray"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
