<ContentDialog
    x:Class="MagiDesk.Client.Views.Dialogs.MenuItemDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Menu Item Details"
    PrimaryButtonText="Save"
    SecondaryButtonText="Cancel"
    DefaultButton="Primary">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10" MinWidth="400">
            <TextBox x:Name="SkuTextBox" Header="SKU" PlaceholderText="e.g. BGR001" InputScope="AlphanumericHalfWidth"/>
            <TextBox x:Name="NameTextBox" Header="Name" PlaceholderText="Item Name"/>
            <TextBox x:Name="DescriptionTextBox" Header="Description" PlaceholderText="Description" AcceptsReturn="True" Height="80"/>
            
            <Grid ColumnDefinitions="*,*">
                <TextBox x:Name="CategoryTextBox" Header="Category" PlaceholderText="Main, Drink, etc." Margin="0,0,5,0"/>
                <TextBox x:Name="GroupTextBox" Header="Group Name" PlaceholderText="Optional group" Grid.Column="1" Margin="5,0,0,0"/>
            </Grid>

            <Grid ColumnDefinitions="*,*">
                <NumberBox x:Name="PriceBox" Header="Selling Price" PlaceholderText="0.00" SpinButtonPlacementMode="Inline" Minimum="0" Margin="0,0,5,0"/>
                <NumberBox x:Name="CostBox" Header="Cost Price" PlaceholderText="Optional" SpinButtonPlacementMode="Inline" Minimum="0" Grid.Column="1" Margin="5,0,0,0"/>
            </Grid>
            
            <TextBox x:Name="PictureUrlTextBox" Header="Picture URL" PlaceholderText="http://..."/>

            <StackPanel Orientation="Horizontal" Spacing="20">
                <CheckBox x:Name="IsAvailableCheckBox" Content="Available" IsChecked="True"/>
                <CheckBox x:Name="IsDiscountableCheckBox" Content="Discountable" IsChecked="True"/>
                <CheckBox x:Name="IsComboCheckBox" Content="Part of Combo"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
