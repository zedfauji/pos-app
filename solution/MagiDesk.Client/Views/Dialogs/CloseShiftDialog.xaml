<ContentDialog
    x:Class="MagiDesk.Client.Views.Dialogs.CloseShiftDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MagiDesk.Client.ViewModels"
    mc:Ignorable="d"
    Title="Close Shift"
    PrimaryButtonText="Close Shift"
    CloseButtonText="Cancel"
    DefaultButton="Primary">
    
    <ContentDialog.Resources>
        <Style x:Key="DifferenceAmountStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="15" Padding="0,10,0,0">
        
        <!-- Sales Summary -->
        <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Total Sales" Foreground="Gray" FontSize="12"/>
                <TextBlock Text="{Binding TotalSales}" FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="Cash Sales" Foreground="Gray" FontSize="12"/>
                <TextBlock Text="{Binding TotalCashSales}" FontSize="16"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Text="Card Sales" Foreground="Gray" FontSize="12"/>
                <TextBlock Text="{Binding TotalCardSales}" FontSize="16"/>
            </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0" Spacing="5">
                <TextBlock Text="Expected Cash" Foreground="Gray"/>
                <TextBlock Text="{Binding ExpectedCash}" FontSize="20"/>
            </StackPanel>
             <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="Difference" Foreground="Gray"/>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="{Binding Difference}" Style="{StaticResource DifferenceAmountStyle}">
                         <TextBlock.Foreground>
                            <SolidColorBrush Color="{Binding IsShort, Converter={StaticResource BoolToColorConverter... wait no converter yet}}" />
                         </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>

        <NumberBox Header="Declared Cash (Counted)" 
                   Value="{Binding DeclaredCash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   SpinButtonPlacementMode="Inline"
                   SmallChange="10" LargeChange="100"
                   Minimum="0" />

        <!-- Alerts -->
        <InfoBar Severity="Error" IsOpen="{Binding IsShort, Mode=OneWay}" 
                 Title="Shortage Detected" 
                 Message="Declared cash is less than expected." />
        
        <InfoBar Severity="Warning" IsOpen="{Binding IsOver, Mode=OneWay}" 
                 Title="Overage Detected" 
                 Message="Declared cash is more than expected." />

        <TextBox Header="Note / Reason" 
                 Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="Explain any difference..." 
                 AcceptsReturn="True" Height="80"/>
    </StackPanel>
</ContentDialog>
