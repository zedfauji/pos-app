<ContentDialog
    x:Class="MagiDesk.Client.Views.Dialogs.OpenShiftDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MagiDesk.Client.ViewModels"
    mc:Ignorable="d"
    Title="Open New Shift"
    PrimaryButtonText="Open Shift"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="15" Padding="0,10,0,0">
        <InfoBar Severity="Informational" IsOpen="True" 
                 Title="Start of Day" 
                 Message="Enter the initial cash amount in the drawer." />

        <NumberBox Header="Starting Cash" 
                   Value="{Binding StartingCash, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   SpinButtonPlacementMode="Inline"
                   SmallChange="10" LargeChange="100"
                   Minimum="0" />

        <TextBox Header="Note (Optional)" 
                 Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 PlaceholderText="e.g. Morning shift, rainy day logic..." 
                 AcceptsReturn="True" Height="80"/>
    </StackPanel>
</ContentDialog>
