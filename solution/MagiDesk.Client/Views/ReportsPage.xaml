<Page
    x:Class="MagiDesk.Client.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MagiDesk.Client.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,20">
            <TextBlock Text="Reports &amp; Analytics" Style="{StaticResource TitleTextBlockStyle}"/>
            <Button Content="Refresh Data" Command="{x:Bind ViewModel.RefreshCommand}" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20"/>
        </StackPanel>

        <!-- KPI Cards -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" VerticalScrollMode="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <!-- Sales Card -->
                <Grid Width="250" Height="150" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Today's Sales" Foreground="Gray" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.SalesStats.TotalSalesToday, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="32" FontWeight="Bold"/>
                        <TextBlock>
                            <Run Text="{x:Bind ViewModel.SalesStats.ClosedSessionsToday, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="Closed Sessions"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Active Card -->
                <Grid Width="250" Height="150" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                         <TextBlock Text="Live Activity" Foreground="Gray" FontWeight="SemiBold"/>
                         <TextBlock Text="{x:Bind ViewModel.SalesStats.OpenSessionsCount, Mode=OneWay}" FontSize="32" FontWeight="Bold"/>
                         <TextBlock Text="Active Tables"/>
                    </StackPanel>
                </Grid>

                <!-- Inventory Card -->
                <Grid Width="250" Height="150" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                         <TextBlock Text="Inventory Health" Foreground="Gray" FontWeight="SemiBold"/>
                         <TextBlock Text="{x:Bind ViewModel.InventoryStats.LowStockCount, Mode=OneWay}" FontSize="32" FontWeight="Bold" Foreground="OrangeRed"/>
                         <TextBlock Text="Low Stock Items"/>
                         <TextBlock FontSize="12" Foreground="Gray">
                             <Run Text="Total Items: "/>
                             <Run Text="{x:Bind ViewModel.InventoryStats.TotalItemCount, Mode=OneWay}"/>
                         </TextBlock>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Placeholder for future charts -->
        <Grid Grid.Row="2" Margin="0,20,0,0" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8">
            <TextBlock Text="Charts coming soon" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray"/>
        </Grid>
    </Grid>
</Page>
