<Page x:Name="PageRoot"
    x:Class="MagiDesk.Client.Views.TableManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MagiDesk.Client.ViewModels"
    xmlns:shared="using:MagiDesk.Shared.DTOs.Tables"
    xmlns:converters="using:MagiDesk.Client.Converters"
    mc:Ignorable="d">

    <Page.Resources>
    <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    <converters:BoolToVisibilityConverter x:Key="InvBoolToVis" Reverse="True" />
    <converters:IntToDoubleConverter x:Key="IntToDouble" />
    <converters:DecimalToDoubleConverter x:Key="DecToDouble" />
</Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Pivot Grid.Column="0">
            <!-- TAB 1: TABLES -->
            <PivotItem Header="Tables">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <CommandBar DefaultLabelPosition="Right">
                        <AppBarButton Icon="Add" Label="Add Table" Command="{x:Bind ViewModel.OpenAddTableCommand}" />
                        <AppBarButton Icon="Refresh" Label="Refresh" Command="{x:Bind ViewModel.LoadDataCommand}" />
                    </CommandBar>
                    
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Tables, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="shared:TableStatusDto">
                                <Grid Padding="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                                        <ColumnDefinition Width="Auto" MinWidth="120"/>
                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" Grid.Column="0"/>
                                    <TextBlock Text="{x:Bind TypeName}" Foreground="Gray" Grid.Column="1"/>
                                    <TextBlock Text="{x:Bind Capacity}" Grid.Column="2"/>
                                    <TextBlock Text="Occupied" 
                                               Visibility="{x:Bind Occupied, Converter={StaticResource BoolToVis}}"
                                               Foreground="OrangeRed" Grid.Column="3"/> 
                                               
                                    <StackPanel Orientation="Horizontal" Grid.Column="5" Spacing="8">
                                        <Button Content="Edit" Command="{Binding ElementName=ViewModelRoot, Path=DataContext.OpenEditTableCommand}" CommandParameter="{Binding}" />
                                        <Button Content="Delete" Command="{Binding ElementName=ViewModelRoot, Path=DataContext.DeleteTableCommand}" CommandParameter="{Binding}" Background="DarkRed" Foreground="White"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <!-- TAB 2: TYPES -->
            <PivotItem Header="Service Types">
                 <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <CommandBar DefaultLabelPosition="Right">
                         <AppBarButton Icon="Refresh" Label="Refresh" Command="{x:Bind ViewModel.LoadDataCommand}" />
                    </CommandBar>

                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Types, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="shared:TableTypeDto">
                                <Grid Padding="12">
                                     <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="16" Grid.Column="0"/>
                                    <TextBlock Text="{x:Bind HourlyRate}" Grid.Column="1"/>
                                    
                                    <StackPanel Grid.Column="2" Orientation="Vertical">
                                        <TextBlock Text="{x:Bind HasTimer}" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Text="{x:Bind RequiresServer}" FontSize="12" Foreground="Gray"/>
                                    </StackPanel>
                                    
                                    <Button Content="Configure" Grid.Column="3" 
                                            Command="{Binding ElementName=ViewModelRoot, Path=DataContext.OpenEditTypeAsyncCommand}" 
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                 </Grid>
            </PivotItem>
        </Pivot>

        <!-- EDITOR PANEL -->
        <Border Grid.Column="1" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1,0,0,0">
            <!-- Table Editor -->
            <Grid Width="320" Visibility="{x:Bind ViewModel.IsTableEditorOpen, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                 <StackPanel Padding="20" Spacing="16">
                     <TextBlock Text="Edit Table" Style="{StaticResource TitleTextBlockStyle}"/>
                     
                     <TextBox Header="Name" Text="{x:Bind ViewModel.EditTableName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                     
                     <ComboBox Header="Table Type" ItemsSource="{x:Bind ViewModel.Types}" DisplayMemberPath="Name" 
                               SelectedItem="{x:Bind ViewModel.EditTableType, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
                               
                     <NumberBox Header="Capacity" Value="{x:Bind ViewModel.EditTableCapacity, Mode=TwoWay, Converter={StaticResource IntToDouble}, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Inline"/>
                     
                     <ToggleSwitch Header="Is Active" IsOn="{x:Bind ViewModel.EditTableActive, Mode=TwoWay}"/>
                     
                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
                         <Button Content="Cancel" Command="{x:Bind ViewModel.CloseTableEditorCommand}"/>
                         <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveTableCommand}"/>
                     </StackPanel>
                 </StackPanel>
            </Grid>
        </Border>
        
        <Border Grid.Column="1" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" 
                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}" BorderThickness="1,0,0,0"
                Visibility="{x:Bind ViewModel.IsTypeEditorOpen, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <Grid Width="320">
                 <StackPanel Padding="20" Spacing="16">
                     <TextBlock Text="Configure Service Type" Style="{StaticResource TitleTextBlockStyle}"/>
                     
                     <TextBox Header="Name" Text="{x:Bind ViewModel.EditTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                     
                     <NumberBox Header="Hourly Rate ($)" Value="{x:Bind ViewModel.EditTypeRate, Mode=TwoWay, Converter={StaticResource DecToDouble}, UpdateSourceTrigger=PropertyChanged}" SpinButtonPlacementMode="Inline"/>
                     
                     <ToggleSwitch Header="Use Timer" IsOn="{x:Bind ViewModel.EditTypeHasTimer, Mode=TwoWay}"/>
                     <ToggleSwitch Header="Require Server Name" IsOn="{x:Bind ViewModel.EditTypeReqServer, Mode=TwoWay}"/>
                     <ToggleSwitch Header="Allow Order Items" IsOn="{x:Bind ViewModel.EditTypeAllowOrders, Mode=TwoWay}"/>
                     
                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
                         <Button Content="Cancel" Command="{x:Bind ViewModel.CloseTypeEditorCommand}"/>
                         <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveTypeCommand}"/>
                     </StackPanel>
                 </StackPanel>
            </Grid>
        </Border>
        
        <!-- Loading Overlay -->
        <Grid Grid.ColumnSpan="2" Background="#80000000" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVis}}">
            <ProgressRing IsActive="True" Width="60" Height="60"/>
        </Grid>
        
        <!-- Element Binding Proxy -->
        <Grid x:Name="ViewModelRoot" Visibility="Collapsed" DataContext="{x:Bind ViewModel}"/> 
    </Grid>
</Page>
